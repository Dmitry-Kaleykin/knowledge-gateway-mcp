{
  "name": "skills-retrieval",
  "version": "0.1.0",
  "private": true,
  "description": "A Pi package for retrieving skills through Scribery and activating them natively.",
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "scribery",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  },
  "skillsRetrieval": {
    "externalServices": {
      "scribery": {
        "transport": "stdio",
        "command": "scribery-mcp",
        "localDevelopmentPath": "../scribery/packages/scribery",
        "requiredTools": [
          "list_documentation_sources",
          "search_documentation"
        ]
      }
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
